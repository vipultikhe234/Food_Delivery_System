#!/bin/sh
# Conventional Commits (REQ-DEVOPS-002 AC4); the same pattern runs in .github/workflows/ci-commits.yml
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'
subject=$(head -n 1 "$1")

case "$subject" in
  Merge\ *|fixup!*|squash!*) exit 0 ;;
esac

if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  echo "commit-msg: subject is not a Conventional Commit:" >&2
  echo "  $subject" >&2
  echo "  expected e.g. 'feat(order): add cancellation endpoint'" >&2
  exit 1
fi
