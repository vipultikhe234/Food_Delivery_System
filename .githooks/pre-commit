#!/bin/sh
# Enable once per clone: git config core.hooksPath .githooks
set -e

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --config .gitleaks.toml
else
  echo "pre-commit: gitleaks not installed; local secret scan skipped (CI still runs it)" >&2
fi

if git diff --cached --name-only | grep -Eq '^(docs/requirements/|tools/requirements-validator/)'; then
  node tools/requirements-validator/src/cli.mjs
fi
