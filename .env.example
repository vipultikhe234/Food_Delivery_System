# Copy to .env (git-ignored) and fill in local values. Never commit real secrets.
# Variables are consumed by Docker Compose (Phase 4) and services via ${VAR} placeholders.
# Names only; values below are placeholders for local development.

# PostgreSQL superuser for the local container (per-service users are created by the init script)
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me-local-only

# Redis (local)
REDIS_PASSWORD=change-me-local-only

# Object storage (MinIO, local)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-local-only

# Payment provider (Razorpay TEST mode keys only; leave empty to use the mock gateway)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# LLM provider for ai-service (Phase 17; empty = scripted fake model)
LLM_API_KEY=
