# Copy to .env (git-ignored) and replace every change-me value. Never commit real secrets.
# Used by Docker Compose (infrastructure/docker/docker-compose.yml) and by services run from the IDE.
# Compose checks all required variables up front, even for profiles you do not start.

# PostgreSQL superuser for the local container
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me-local-only
# Passwords for the per-service roles created by the init script (<service>_owner, <service>_app)
LOCAL_DB_OWNER_PASSWORD=change-me-local-only
LOCAL_DB_APP_PASSWORD=change-me-local-only

# Redis (local)
REDIS_PASSWORD=change-me-local-only

# Object storage (MinIO, local)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-local-only

# config-server HTTP Basic credentials (server and clients)
CONFIG_SERVER_USER=config-client
CONFIG_SERVER_PASSWORD=change-me-local-only

# Grafana (observability profile)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-only

# Tracing: true sends spans to the otel-collector (start the observability profile first)
TRACING_EXPORT_ENABLED=false

# Bind address for the gateway port; 0.0.0.0 lets a phone on the same network reach it
GATEWAY_BIND_ADDRESS=127.0.0.1

# Payment provider (Razorpay TEST mode keys only; leave empty to use the mock gateway)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# LLM provider for ai-service (Phase 17; empty = scripted fake model)
LLM_API_KEY=
